# Bu dosyayı ".env" olarak kopyalayıp doldurun. Gerçek sırları asla repoya eklemeyin.

# --- Genel ---
APP_ENV=development
LOG_LEVEL=info
# AgentCard'ta ilan edilecek ana bilgisayar (compose'da servis adı, yerelde 127.0.0.1).
AGENT_ADVERTISE_HOST=127.0.0.1

# --- PostgreSQL (+pgvector) ---
POSTGRES_USER=crew
POSTGRES_PASSWORD=crew
POSTGRES_DB=crew
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT (HS256) ---
# En az 32 baytlık rastgele bir değer kullanın.
JWT_SECRET=change-me-in-production-please-32-bytes-min
JWT_ISSUER=a2a-research-crew
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# --- Ajan portları (host üzerinde çalıştırma için) ---
ORCHESTRATOR_REST_PORT=9100
ORCHESTRATOR_CARD_PORT=9200
MARKET_SCOUT_GRPC_PORT=9101
MARKET_SCOUT_CARD_PORT=9201
COMPETITOR_ANALYST_GRPC_PORT=9102
COMPETITOR_ANALYST_CARD_PORT=9202
REPORT_WRITER_GRPC_PORT=9103
REPORT_WRITER_CARD_PORT=9203

# --- Orchestrator -> uzman ajan AgentCard URL'leri ---
MARKET_SCOUT_URL=http://127.0.0.1:9201
COMPETITOR_ANALYST_URL=http://127.0.0.1:9202
REPORT_WRITER_URL=http://127.0.0.1:9203

# --- Auth (demo yönetici kullanıcısı) ---
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me-admin-password
AUTH_ADMIN_ROLES=admin,researcher

# --- CLI (istemci tarafı) ---
A2A_SERVER_URL=http://127.0.0.1:9200
A2A_TOKEN_FILE=

# --- LLM sağlayıcıları ---
# mock: ağ erişimi gerektirmeyen deterministik sağlayıcı (test/dry-run için).
LLM_PROVIDER=mock
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_GEMINI_API_KEY=
# OpenAI uyumlu bir ağ geçidi üzerinden serbest model ID'leri için.
LLM_OPENAI_COMPAT_BASE_URL=
LLM_OPENAI_COMPAT_API_KEY=

# Ajan bazlı model kimlikleri (boş = sağlayıcı varsayılanı).
MARKET_SCOUT_MODEL=
COMPETITOR_ANALYST_MODEL=
REPORT_WRITER_MODEL=

# --- MCP ---
# Gerçek web-arama MCP sunucusu (streamable HTTP). Boşsa deterministik sahte
# in-process arama sunucusu kullanılır.
MCP_WEBSEARCH_URL=
MCP_WEBSEARCH_API_KEY=
# competitor-analyst için izole sqlite çalışma alanı.
MCP_SQLITE_DIR=./data/sqlite
# report-writer için dosya sistemi MCP çalışma alanı (jail kökü).
MCP_FS_ROOT=./data/workspace

# --- Artefakt blob deposu ---
BLOB_STORE=fs
BLOB_FS_ROOT=./data/artifacts
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=artifacts
